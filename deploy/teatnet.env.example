TEATNET_ADDR=127.0.0.1:8091
TEATNET_BASE_URL=https://teatnet.tainodev.com.br
TEATNET_DATA=/opt/teatnet/data
TEATNET_ADMIN_EMAIL=
TEATNET_BEHIND_CF=1

# E-mail do link mágico (ex.: Brevo: smtp-relay.brevo.com, porta 587)
TEATNET_SMTP_HOST=
TEATNET_SMTP_PORT=587
TEATNET_SMTP_USER=
TEATNET_SMTP_PASS=
TEATNET_MAIL_FROM=

# Cloudflare Turnstile (captcha) - painel da Cloudflare > Turnstile
TEATNET_TURNSTILE_SITE=
TEATNET_TURNSTILE_SECRET=
