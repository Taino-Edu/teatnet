teatnet.tainodev.com.br {
	# certificado de origem da Cloudflare, o mesmo da tainodev (cobre *.tainodev.com.br)
	tls /etc/caddy/certs/tainodev.pem /etc/caddy/certs/tainodev.key
	encode zstd gzip
	reverse_proxy 127.0.0.1:8091 {
		# Reescreve o header com o IP já validado pelo Caddy (trusted_proxies da Cloudflare,
		# no bloco global da VPS): o app nunca recebe um CF-Connecting-IP forjado.
		header_up CF-Connecting-IP {client_ip}
	}
}
